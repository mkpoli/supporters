{
	// Set the Ko-fi webhook token (Ko-fi → Settings → API → Webhooks) as a secret:
	//   bunx wrangler secret put KOFI_TOKEN
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "supporters",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
	"d1_databases": [
		{ "binding": "DB", "database_name": "supporters", "database_id": "620aa7ce-e27d-4962-88f7-613f0d44bec9", "migrations_dir": "migrations" }
	],
	"observability": { "enabled": true },
	"routes": [{ "pattern": "supporters.mkpo.li", "custom_domain": true }]
}
